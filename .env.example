# Скопируйте в .env и впишите ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key

# Адрес Milvus: по умолчанию база из docker-compose.yml.
# Без Docker укажите файл, тогда базой будет Milvus Lite: MILVUS_URI=milvus.db
MILVUS_URI=http://localhost:19530

# Ограничения расходов: стоимость приходит от провайдера после ответа,
# поэтому следующий сетевой вызов блокируется после достижения лимита.
MAX_TASK_CENTS=5
MAX_DAILY_CENTS=500
